{
  "version": 8,
  "name": "CyclOSM Vector",
  "metadata": {
    "mapbox:type": "template",
    "mapbox:groups": {
      "Cycling": {"collapsed": false, "name": "Cycling Infrastructure"}
    }
  },
  "sources": {
    "local-tiles": {
      "type": "vector",
      "tiles": ["http://localhost:8080/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f0ede5"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "local-tiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c7e0e8"
      }
    },
    {
      "id": "roads-all",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": [
          "match",
          ["get", "highway"],
          "cycleway",
          "#2fb344",
          "primary",
          "#e8b78a",
          "secondary",
          "#f4e4c3",
          "tertiary",
          "#fff8f3",
          "residential",
          "#ffffff",
          "#cccccc"
        ],
        "line-width": {
          "base": 1,
          "stops": [
            [5, 0.3],
            [12, 1.2],
            [14, 2.5]
          ]
        }
      },
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      }
    },
    {
      "id": "cycleways",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": [
          "match",
          ["get", "highway"],
          "cycleway",
          "#2fb344",
          "primary",
          "#e8b78a",
          "secondary",
          "#f4e4c3",
          "#ffffff"
        ],
        "line-width": {
          "base": 1.1,
          "stops": [
            [8, 0.8],
            [12, 2],
            [14, 3.5]
          ]
        },
        "line-opacity": 0.9
      },
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "metadata": {
        "mapbox:group": "Cycling"
      }
    },
    {
      "id": "poi-points",
      "type": "circle",
      "source": "local-tiles",
      "source-layer": "poi",
      "paint": {
        "circle-radius": {
          "base": 5,
          "stops": [
            [8, 3],
            [12, 6],
            [14, 8]
          ]
        },
        "circle-color": [
          "match",
          ["get", "amenity"],
          "cafe",
          "#d4a574",
          "restaurant",
          "#d47b3d",
          "pharmacy",
          "#e74c3c",
          "#999999"
        ],
        "circle-opacity": 0.8
      },
      "metadata": {
        "mapbox:group": "Cycling"
      }
    },
    {
      "id": "bicycle-no",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "bicycle"], "no"],
      "paint": {
        "line-color": "#ff0000",
        "line-width": {
          "base": 1.2,
          "stops": [
            [10, 1.5],
            [12, 2.5],
            [16, 4]
          ]
        },
        "line-opacity": 0.7
      },
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "metadata": {
        "mapbox:group": "Cycling"
      }
    },
    {
      "id": "trails",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "highway"], ["literal", ["path", "footway", "track", "steps", "pedestrian"]]],
      "paint": {
        "line-color": [
          "match",
          ["get", "highway"],
          "path",
          "#8B4513",
          "footway",
          "#D2691E",
          "track",
          "#A0522D",
          "steps",
          "#CD853F",
          "#8B4513"
        ],
        "line-width": {
          "base": 1.2,
          "stops": [
            [10, 0.5],
            [12, 1.5],
            [16, 3]
          ]
        },
        "line-opacity": 0.85,
        "line-dasharray": [2, 2]
      },
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "metadata": {
        "mapbox:group": "Cycling"
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "local-tiles",
      "source-layer": "poi",
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 10,
        "text-offset": [0, 1.5],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-labels-small",
      "type": "symbol",
      "source": "local-tiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": ["in", ["get", "place"], ["literal", ["village", "hamlet", "suburb", "neighbourhood"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
        "text-size": {
          "stops": [
            [10, 11],
            [14, 14]
          ]
        },
        "text-anchor": "center",
        "text-offset": [0, 0.2],
        "text-allow-overlap": false,
        "text-optional": true
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2,
        "text-halo-blur": 1
      }
    },
    {
      "id": "place-labels-large",
      "type": "symbol",
      "source": "local-tiles",
      "source-layer": "place",
      "minzoom": 4,
      "filter": ["in", ["get", "place"], ["literal", ["city", "town"]]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Bold", "Arial Unicode MS Bold"],
        "text-size": {
          "stops": [
            [4, 12],
            [8, 16],
            [12, 20]
          ]
        },
        "text-anchor": "center",
        "text-offset": [0, 0],
        "text-allow-overlap": false,
        "text-optional": false,
        "symbol-sort-key": ["get", "population"]
      },
      "paint": {
        "text-color": "#1a1a1a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 3,
        "text-halo-blur": 1
      }
    }
  ]
}
