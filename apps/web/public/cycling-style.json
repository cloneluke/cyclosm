{
  "version": 8,
  "name": "CyclOSM Vector",
  "metadata": {
    "mapbox:type": "template",
    "mapbox:groups": {
      "Cycling": {"collapsed": false, "name": "Cycling Infrastructure"}
    }
  },
  "sources": {
    "local-tiles": {
      "type": "vector",
      "tiles": ["http://localhost:8080/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f0ede5"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "local-tiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c7e0e8"
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "highway"], "primary"],
      "paint": {
        "line-color": "#e8b78a",
        "line-width": {
          "base": 1.2,
          "stops": [
            [5, 0.5],
            [12, 2],
            [14, 4]
          ]
        }
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "highway"], "secondary"],
      "paint": {
        "line-color": "#f4e4c3",
        "line-width": {
          "base": 1.1,
          "stops": [
            [5, 0.4],
            [12, 1.5],
            [14, 3]
          ]
        }
      }
    },
    {
      "id": "roads-tertiary",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "highway"], "tertiary"],
      "paint": {
        "line-color": "#fff8f3",
        "line-width": {
          "base": 1,
          "stops": [
            [5, 0.3],
            [12, 1],
            [14, 2]
          ]
        }
      }
    },
    {
      "id": "roads-residential",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "highway"], "residential"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "base": 0.9,
          "stops": [
            [5, 0.2],
            [12, 0.8],
            [14, 1.5]
          ]
        }
      }
    },
    {
      "id": "roads-unclassified",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "highway"], "unclassified"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "base": 0.8,
          "stops": [
            [5, 0.15],
            [12, 0.6],
            [14, 1.2]
          ]
        }
      }
    },
    {
      "id": "cycleways",
      "type": "line",
      "source": "local-tiles",
      "source-layer": "roads",
      "filter": ["==", ["get", "highway"], "cycleway"],
      "paint": {
        "line-color": "#2fb344",
        "line-width": {
          "base": 1.1,
          "stops": [
            [8, 0.8],
            [12, 2],
            [14, 3.5]
          ]
        },
        "line-opacity": 0.9
      },
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "metadata": {
        "mapbox:group": "Cycling"
      }
    },
    {
      "id": "poi-points",
      "type": "circle",
      "source": "local-tiles",
      "source-layer": "poi",
      "paint": {
        "circle-radius": {
          "base": 5,
          "stops": [
            [8, 3],
            [12, 6],
            [14, 8]
          ]
        },
        "circle-color": [
          "match",
          ["get", "amenity"],
          "cafe",
          "#d4a574",
          "restaurant",
          "#d47b3d",
          "pharmacy",
          "#e74c3c",
          "#999999"
        ],
        "circle-opacity": 0.8
      },
      "metadata": {
        "mapbox:group": "Cycling"
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "local-tiles",
      "source-layer": "poi",
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 10,
        "text-offset": [0, 1.5],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
