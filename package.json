{
  "name": "cyclosm-vector",
  "version": "0.1.0",
  "private": true,
  "description": "Modern vector tile map for cyclists using MapLibre GL",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "docker compose -f infrastructure/tile-server/docker-compose.yml up",
    "tile-gen": "docker compose -f infrastructure/tile-server/docker-compose.yml --profile tile-generation up planetiler",
    "tiles:update": "bash ./scripts/update-tiles.sh",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "pnpm": ">=10.0.0",
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
